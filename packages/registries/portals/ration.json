{
  "id": "ration_mock",
  "domain": "civil_services",
  "service": "ration_card",
  "title": "Ration Card Portal (DEMO)",
  "url": "/mock/ration",
  "domains_allowed": [
    "localhost",
    "127.0.0.1"
  ],
  "official_url": "https://nfsa.gov.in/portal/apply",
  "allowed_domains": [
    "nfsa.gov.in"
  ],
  "mock_url": "/mock/ration",
  "login_required": false,
  "fillable": true,
  "notes": "NFSA directs applicants to their State/UT ration-card portal.",
