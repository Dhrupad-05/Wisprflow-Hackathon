      "id": "name",
      "type": "text",
      "labels": {
        "en": "Name",
        "hi": "नाम",
        "bn": "নাম"
      }
    },
    {
      "id": "members",
      "type": "number",
      "min": 1,
      "max": 20,
      "labels": {
        "en": "Family members",
        "hi": "परिवार के सदस्य",
        "bn": "পরিবারের সদস্য"
      }
    },
    {
      "id": "otp",
      "type": "digits",
      "len": 6,
      "sensitive": true,
      "labels": {
        "en": "OTP",
        "hi": "ओटीपी",
        "bn": "ওটিপি"
      }
    }
  ]
}
