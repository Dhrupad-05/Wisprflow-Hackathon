      "labels": {
        "en": "Amount",
        "hi": "राशि",
        "bn": "টাকার পরিমাণ"
      }
    },
    {
      "id": "otp",
      "type": "digits",
      "len": 6,
      "sensitive": true,
      "labels": {
        "en": "OTP",
        "hi": "ओटीपी",
        "bn": "ওটিপি"
      }
    }
  ]
