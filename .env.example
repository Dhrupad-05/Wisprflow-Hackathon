[TEMPLATE]
# Copy to .env. Never commit real values. All keys are server-side only.
APP_ENV=demo
# Wispr Flow speech-to-text (server-side). https://api-docs.wisprflow.ai
WISPR_API_KEY=
WISPR_API_URL=https://platform-api.wisprflow.ai/api/v1/dash/api
WISPR_TIMEOUT_SECONDS=20
# Optional alternate speech-to-text provider.
XAI_STT_API_KEY=
XAI_STT_API_URL=https://api.x.ai/v1/stt
XAI_STT_MODEL=grok-voice-transcribe-2.0
XAI_TTS_API_KEY=
XAI_TTS_API_URL=https://api.x.ai/v1/tts
XAI_TTS_VOICE=eve
# Local, offline speech-to-text via faster-whisper (CPU). No key required.
WHISPER_MODEL=small
WHISPER_MODEL_DIR=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_ENABLED=1
WHISPER_PRELOAD=1
WHISPER_AUTO_DOWNGRADE=1
# Fall-through order. Empty provider keys are skipped automatically.
STT_ORDER=wispr_api,whisper_local,xai_stt,web_speech,text
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_LLM_API_KEY=
XAI_LLM_MODEL=grok-3-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
XAI_FALLBACK_API_KEY=
XAI_FALLBACK_MODEL=grok-3-mini
SESSION_TTL_SECONDS=1800
RATE_LIMIT_PER_MINUTE=1000
ALLOWED_ORIGINS=localhost,127.0.0.1
LOG_LEVEL=INFO
